# --- Host ports -------------------------------------------------------------
# The host already runs a native Ollama on 11434, so the container uses 11435.
WEBGUI_PORT=8080
OLLAMA_PORT=11435

# --- Ollama runtime tuning --------------------------------------------------
# Everything between the markers is written by `scripts/autotune.sh --apply`,
# sized to the GPU that was detected. Edit it by hand if you like, but the next
# autotune run will rewrite the block, so put lasting changes outside it.
# >>> autotune >>>
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
# <<< autotune <<<

# How long an idle model stays resident. Longer avoids reloading between
# requests; shorter hands VRAM back sooner.
OLLAMA_KEEP_ALIVE=30m

# Browsers talking to the container's API directly, bypassing the nginx proxy.
OLLAMA_ORIGINS=*
