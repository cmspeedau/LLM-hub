# LLM Hub configuration.
# Copy to .env and adjust. Used by docker compose and make retune.

# --- Ports -------------------------------------------------------------------
WEBGUI_PORT=8080
LLAMA_PORT=8081

# --- Model engine tuning (llama-server) --------------------------------------
# Managed by `make retune`, which rewrites this block to fit the detected GPU.
LLAMA_CTX_SIZE=8192
LLAMA_CACHE_TYPE_K=q8_0
LLAMA_FLASH_ATTN=1
# -1 = keep all layers on the GPU; 0 = CPU only.
LLAMA_N_GPU_LAYERS=-1
